{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@lib/*": ["./lib/*"]
    }
  },
  "include": ["lib/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
