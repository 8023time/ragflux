# ragflux server environment
# Copy this file to .env and replace every required value.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DATABASE=ragflux

# Cloudflare R2 / S3-compatible object storage
R2_REGION=auto
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ragflux
R2_PUBLIC_BASE_URL=https://storage.ragflux.8023time.com

# JWT authentication
JWT_SECRET=

# LLM chat model
LLM_CHAT_BASE_URL=https://api.openai.com/v1
LLM_CHAT_API_KEY=
LLM_CHAT_MODEL=

# LLM vision model for images and scanned documents
LLM_VISION_BASE_URL=https://api.openai.com/v1
LLM_VISION_API_KEY=
LLM_VISION_MODEL=

# LLM embedding model for vectorization
LLM_EMBEDDING_BASE_URL=https://api.openai.com/v1
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_MODEL=

# Resend email service
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@ragflux.8023time.com

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ。Relay 发布 Outbox，Worker 消费文档解析。队列里只有文档编号，正文在 PostgreSQL。
# 地址必须带账号密码。未写用户时客户端会用 guest，从宿主机连进容器会被拒绝。
RABBITMQ_URL=amqp://USER:PASSWORD@127.0.0.1:5672