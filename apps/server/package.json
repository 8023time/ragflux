    "prisma:plan": "prisma migration plan",
    "prisma:apply": "prisma db migrate",
    "prisma:status": "prisma migration status",
    "deploy": "nest deploy",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint apps/ libs/"
  },
